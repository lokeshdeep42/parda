<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Parda never declares INTERNET. tools:node="remove" also strips it if any library
      tries to merge it in, so the shipped APK provably cannot open a socket.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PardaApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@drawable/ic_parda"
        android:roundIcon="@drawable/ic_parda"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Parda"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to Parda": text arrives in the Airlock, nothing leaves. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Select text in any app, then "Mask with Parda": the selection is replaced in place. -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/process_text_label"
            android:theme="@style/Theme.Parda.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".service.InterceptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Parda.Translucent" />

        <service
            android:name=".service.CheckoutWatchService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/checkout_service" />
        </service>
    </application>
</manifest>
